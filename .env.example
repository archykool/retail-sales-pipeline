# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Config is read by src/config.py (Step 2) and by docker-compose.yml (Step 1).

# ── PostgreSQL connection ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_dev
DB_USER=postgres
DB_PASSWORD=replace_me

# ── Input data paths (relative to repo root) ──
SALES_FILE=data/raw/sales_2026_01.csv
CUSTOMERS_FILE=data/raw/customers.json
PRODUCTS_FILE=data/raw/products.json
REJECTED_DIR=data/rejected

# ── Validator thresholds ──
MAX_QUANTITY=1000

# ── Loader ──
LOAD_BATCH_SIZE=1000
